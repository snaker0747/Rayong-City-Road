{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roadsdata",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roadsdata-db",
      // ใส่ค่า database_id ที่ได้จากคำสั่ง: npx wrangler d1 create roadsdata-db
      "database_id": "5ca64805-1228-4e39-8027-09c0c744f448",
      "migrations_dir": "migrations"
    }
  ],
  // ปิด preview URL ให้มีที่อยู่เว็บเดียว
  "preview_urls": false,
  "observability": { "enabled": true }
}
